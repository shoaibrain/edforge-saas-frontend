{
  "name": "@edforge/forms",
  "version": "0.0.1",
  "description": "Shared form components for EdForge EMIS platform",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./fields": {
      "import": "./src/fields/index.ts",
      "types": "./src/fields/index.ts"
    },
    "./sections": {
      "import": "./src/sections/index.ts",
      "types": "./src/sections/index.ts"
    },
    "./schemas": {
      "import": "./src/schemas/index.ts",
      "types": "./src/schemas/index.ts"
    },
    "./hooks": {
      "import": "./src/hooks/index.ts",
      "types": "./src/hooks/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aibrains/shared-types": "^0.35.0",
    "@edforge/config": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.511.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "zod": "~3.24.4"
  },
  "devDependencies": {
    "@edforge/ui": "workspace:*",
    "@types/react": "^19.1.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
