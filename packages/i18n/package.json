    "react-i18next": "^16.5.4",
    "i18next-browser-languagedetector": "^8.0.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@edforge/archetype": "workspace:*",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
