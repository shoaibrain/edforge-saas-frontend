{
  "name": "@edforge/types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./person": {
      "types": "./dist/person.d.ts",
      "import": "./dist/person.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "import": "./dist/tenant.js"
    },
    "./use-currency": {
      "types": "./dist/use-currency.d.ts",
      "import": "./dist/use-currency.js"
    },
    "./format-currency": {
      "types": "./dist/format-currency.d.ts",
      "import": "./dist/format-currency.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aibrains/shared-types": "^0.86.0",
    "@edforge/config": "workspace:*",
    "zod": "~3.24.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^5.6.0"
  }
}
