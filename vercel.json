{
  "buildCommand": "bash scripts/build-deploy.sh",
  "outputDirectory": "output",
  "installCommand": "npm i -g pnpm@9.15.0 && pnpm install",
  "framework": null,
  "routes": [
    {
      "src": "/remotes/(.*)/remoteEntry\\.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/remotes/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "${API_BASE_URL}/$1",
      "env": ["API_BASE_URL"]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
