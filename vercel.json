{
  "buildCommand": "bash scripts/build-deploy.sh",
  "outputDirectory": "output",
  "installCommand": "npm i -g pnpm@10.33.0 && pnpm install --frozen-lockfile",
  "framework": null,
  "headers": [
    {
      "source": "/remotes/:path*/remoteEntry.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/remotes/:path*/mf-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/remotes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${API_BASE_URL}/$1",
      "env": ["API_BASE_URL"]
    },
    { "handle": "filesystem" },
    {
      "src": "/remotes/(.*)\\.(js|css|json|map)$",
      "status": 404
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
