{
  "buildCommand": "bash scripts/build-deploy.sh",
  "outputDirectory": "output",
  "installCommand": "npm i -g pnpm@9.15.0 && pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/remotes/:path*", "destination": "/remotes/:path*" },
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/api/:path*", "destination": "https://1hq87iv6i3.execute-api.us-east-2.amazonaws.com/prod/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/remotes/(.*)/remoteEntry.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/remotes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
