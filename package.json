{
  "name": "edforge-mfe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --concurrency 20",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "rm -rf node_modules **/*/node_modules **/*/.turbo **/*/dist **/*/.cache .turbo dist .cache pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev:shell": "turbo dev --filter=@edforge/shell",
    "dev:edfi": "turbo dev --filter=@edforge/edfi",
    "dev:academics": "turbo dev --filter=@edforge/academics",
    "build:packages": "turbo build --filter=./packages/*",
    "build:deploy": "bash scripts/build-deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up",
    "docker:build": "docker-compose -f docker/docker-compose.dev.yml build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "framer-motion": "^11.15.0"
  }
}