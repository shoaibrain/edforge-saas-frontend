{
  "name": "edforge-mfe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --concurrency 20",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "rm -rf node_modules **/*/node_modules **/*/.turbo **/*/dist **/*/.cache .turbo dist .cache pnpm-lock.yaml **/*/tsconfig.tsbuildinfo",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev:shell": "turbo dev --filter=@edforge/shell",
    "dev:academics": "turbo dev --filter=@edforge/academics",
    "dev:finance": "turbo dev --filter=@edforge/finance",
    "dev:people": "turbo dev --filter=@edforge/people",
    "dev:mvp": "turbo dev --filter=@edforge/shell --filter=@edforge/academics --filter=@edforge/people --filter=@edforge/finance --filter='./packages/*' --concurrency 20",
    "build:mvp": "turbo build --filter=@edforge/shell --filter=@edforge/academics --filter=@edforge/people --filter=@edforge/finance --filter='./packages/*' --filter='./types/packages/*'",
    "build:packages": "turbo build --filter=./packages/*",
    "build:deploy": "bash scripts/build-deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up",
    "docker:build": "docker-compose -f docker/docker-compose.dev.yml build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.6.0",
    "jsdom": "^28.0.0",
    "msw": "^2.12.10",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^6",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "framer-motion": "^11.15.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^16.5.4"
  }
}