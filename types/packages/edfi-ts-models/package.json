{
  "name": "@edforge/edfi-ts-models",
  "version": "1.0.0",
  "description": "TypeScript interfaces generated from Ed-Fi Data Standard JSON schemas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "ts-node scripts/generate-local.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "prepublishOnly": "pnpm generate && pnpm build"
  },
  "keywords": [
    "ed-fi",
    "typescript",
    "education",
    "data-models"
  ],
  "author": "Shoaib Rain",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "json-schema-to-typescript": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/models/domains/*/index.d.ts",
      "default": "./dist/models/domains/*/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ]
}
