# EdForge Shell — Environment Variables
# Copy to .env.local for local development.
# Get real values from the team's secure vault or AWS console.
# DO NOT commit .env.local — it is gitignored.

# API Configuration
VITE_API_URL=

# Authentication (AWS Cognito)
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_SIGN_IN=http://localhost:3000/
VITE_REDIRECT_SIGN_OUT=http://localhost:3000/

# Landing asset host override. When unset, assets are served from the
# shell's /landing/ public dir. Set to a CDN origin (no trailing slash) to
# serve platform-overview.mp4 + task-router.mp4 from there.
VITE_LANDING_ASSETS_URL=
